# OpenRouter API key used for chat completions.
OPENROUTER_API_KEY="Your API KEY Here"

# Optional separate key for embeddings. If blank, OPENROUTER_API_KEY is used.
OPENROUTER_EMBEDDING_API="Your API KEY Here"

# Model IDs are configurable. Confirm that your chosen OpenRouter models
# currently support chat completions / embeddings for your account.
CHAT_MODEL=nvidia/nemotron-3.5-lightning:free
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Project-relative paths (do not commit secrets or private PDFs).
PDF_PATH=./data/muse.pdf
CHROMA_DIR=./storage/chroma
CHROMA_COLLECTION=muse_pdf
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_K=5
MAX_REWRITES=2
TEMPERATURE=0
